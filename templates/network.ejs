package networks

import (
"github.com/ethereum/go-ethereum/common"
)
<%
    var uni = chain.uniswap;
    var tok = chain.token;
    var oku = chain.oku;
    var cons = chain.contracts;
    var pxs = oku.pricing;
    var explorers = chain.blockExplorers;
%>

var <%- helpers.snakeToCamel(chainName) %> Network = Network{
  ChainId: <%- chain.id %>,
  LogoUrl: "<%- chain.logoUrl %>",
  SortIndex: <%- chain.sortIndex %>,
  SafeReorgDistance: <%- chain.safeReorgDistance || 90000 %>,
  BlockExplorers: map[string]BlockExplorer {<% for(const prop of Object.entries(explorers)) {%> <% if(prop[1].name){ %>
    <%- h.formatValue(prop[0],"s") %>: {
      Url: <%- h.formatValue(prop[1].url,"s") %>,
      <%- prop[1].apiUrl ? "ApiUrl:" + h.formatValue(prop[1].apiUrl, "s")+"," : "" %>
    }, <% } %> <% } %>
  },
  DefaultPool: <%- helpers.toAddr(chain.defaultPool) %>,
  InternalName:     "<%- chain.internalName %>",
  InitCodeHash:    common.HexToHash("<%- chain.initCodeHash %>"),
  ExternalId:  map[string]string{ <% for(const prop of Object.entries(chain.externalId)) {%>
    "<%- prop[0] %>": "<%- prop[1] %>",<% } %>
  },
  DefaultToken0:    common.HexToAddress("<%- chain.defaultToken0 %>"),
  DefaultToken1:    common.HexToAddress("<%- chain.defaultToken1 %>"),
  //TODO: TokenList:        []any{},
  Stables:          []common.Address{<%- chain.stables.map(h.toAddr).join(",") %>},
  StablecoinMap:          map[common.Address]struct{}{<%- chain.stables.map(x=>`${h.toAddr(x)}: {}`).join(",") %>},
  Watchlist:          []common.Address{<%- chain.watchlist.map(h.toAddr).join(",") %>},
  BlockTimeSeconds: <%- chain.blockTimeSeconds %>,
  Oku:            OkuMetadata{
     <%- oku.limitOrderRegistry ? "LimitOrderRegistry:" + h.formatValue(oku.limitOrderRegistry, "a")+"," : "" %>
    <%- oku.limitOrderRegistryDeployBlock ? "LimitOrderRegistryDeployBlock:"+ h.formatValue(oku.limitOrderRegistryDeployBlock, "n")+",": "" %>
    Pricing: OkuPricingMetadata{
<% if(pxs.nativeWrappedToken !== undefined){%>    NativeWrappedToken: <%- h.formatValue(pxs.nativeWrappedToken, "a") %>,<% } %>
<% if(pxs.nativeWrappedName !== undefined){%>    NativeWrappedName: <%- h.formatValue(pxs.nativeWrappedName, "s") %>,<% } %>
      Pools:          []common.Address{<%- pxs.pools ? pxs.pools.map(h.toAddr).join(",") : "" %>},
      NativeQuotePools: []ChainContract{<% for(const p of (pxs.nativeQuotePools || []) ) {%>
        {
          BlockCreated: <%- p.blockCreated || 0 %>,
          Address: <%- h.formatValue(p.address,"a") %>,
        }, <% } %>
      },
    },
  },
  Uniswap:          UniswapMetadata{ <% for(const prop of Object.entries(uni)) {%>
    <%- h.snakeToCamel(prop[0]) %>: <%- h.formatValue(prop[1], h.isString(prop[1]) ? (h.isAddress(prop[1]) ? "a" : "s") : "n") %> , <% } %>
  },
  Token:          TokenMetadata{ <% for(const prop of Object.entries(tok)) {%>
    <%- h.snakeToCamel(prop[0]) %>: <%- h.formatValue(prop[1], h.isString(prop[1]) ? "a" : "n") %> , <% } %>
  },
  Contracts: map[string]ChainContract{<% for(const prop of Object.entries(cons)) {%> <% if(prop[1].address){ %>
    <%- h.formatValue(prop[0],"s") %>: {
      BlockCreated: <%- prop[1].blockCreated || 0 %>,
      Address: <%- h.formatValue(prop[1].address,"a") %>,
      }, <% } %> <% } %>
  },
}
