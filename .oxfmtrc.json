{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": false,
	"printWidth": 80,
	"sortImports": {},
	"sortPackageJson": true,
	"ignorePatterns": [
		"dist/**",
		"static/**",
		"templates/**",
		"integration/**",
		"bump/**",
		".yarn/**",
		"yarn.lock",
		"CHANGELOG.md"
	]
}
